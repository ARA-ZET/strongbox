{
  "name": "strongbox-functions",
  "description": "StrongBox Cloud Functions \u2014 invoicing, notifications, push and email.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulator": "firebase emulators:exec --project demo-strongbox --only firestore,functions \"node --test --test-concurrency=1 test-emulator/\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
