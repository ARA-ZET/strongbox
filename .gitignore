# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.log
.idea/
*.iml

# ── Flutter app (app/) ────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.pub-cache/
app/.pub/
app/coverage/
app/**/doc/api/
app/**/ios/Flutter/.last_build_id
app/android/app/debug
app/android/app/profile
app/android/app/release
app/.metadata

#   Generated Dart sources ARE committed (freezed / riverpod / json / design tokens)
#   so CI and deploys build without a codegen step. Do not ignore *.g.dart / *.freezed.dart.

# ── Next.js site (web/) ───────────────────────────────────────
web/node_modules/
web/.next/
web/out/
web/build/
web/dist/
web/.env
web/.env*.local
web/*.tsbuildinfo
web/tsconfig.tsbuildinfo

# ── Firebase ──────────────────────────────────────────────────
.firebase/
firebase-debug.log
firebase-debug.*.log
.runtimeconfig.json

# ── Secrets / local config — NEVER COMMIT (see docs/SECURITY.md) ──
#   Real values live locally + in CI secrets. Commit only the *.example twins.
app/lib/core/firebase_options.dart
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
!**/*.example
.claude/settings.local.json
**/.claude/settings.local.json
**/*.env
**/.env
**/.env.*
!**/.env.example
*.keystore
*.jks
**/serviceAccount*.json
**/service-account*.json
**/*-service-account*.json

# ── Node (packages/) ──────────────────────────────────────────
node_modules/
