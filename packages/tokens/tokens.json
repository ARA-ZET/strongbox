{
  "$comment": "Single source of truth for StrongBox visual design. Edit here, then run `node packages/tokens/build.mjs` to regenerate app/ and web/ outputs.",
  "color": {
    "navy": "#1A2B4A",
    "amber": "#FEAE2C",
    "amberDark": "#8A5A00",

    "scaffold": "#F5F2FF",
    "surface": "#FFFFFF",
    "surfaceContainer": "#EFECFF",

    "textPrimary": "#1A1A2E",
    "textSecondary": "#44474E",
    "textHint": "#75777E",

    "border": "#C5C6CF",

    "overlay": "#00000080",
    "cardShadow": "#00000014",

    "statusSuccess": "#00A858",
    "statusSuccessBg": "#E8F5F0",
    "statusWarning": "#E67E22",
    "statusWarningBg": "#FFF3E0",
    "statusError": "#BA1A1A",
    "statusErrorBg": "#FFEBEB",
    "statusPending": "#75777E",
    "statusPendingBg": "#F0F0F0",
    "statusPastDue": "#835500",
    "statusPastDueBg": "#FFF0D4"
