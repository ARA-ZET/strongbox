rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function isDriver() { return signedIn() && me().role == 'driver'; }
    function isClient() { return signedIn() && me().role == 'client'; }
    function myClientId() { return me().clientId; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsClientDoc(data) {
      return isClient() &&
        (data.primaryUserId == request.auth.uid || data.id == myClientId());
    }

    // ---- Users ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self sign-up is always a client with no client record linked yet;
      // staff roles are granted by an admin.
      allow create: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.role == 'client' &&
          request.resource.data.get('clientId', null) == null);
      // Users edit their own profile, never their role, tenant or billing
      // state. clientId is set once, to a client record they own.
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['role', 'tenantId', 'isDeleted', 'subscriptionStatus',
             'stripeCustomerId']) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['clientId']) ||
            (resource.data.get('clientId', null) == null &&
              get(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
                .data.primaryUserId == request.auth.uid)));
    }

    // ---- Clients -------------------------------------------------------
    match /clients/{clientId} {
      allow read: if isAdmin() || ownsClientDoc(resource.data);
      allow create: if isAdmin() ||
        (isClient() && request.resource.data.primaryUserId == request.auth.uid) ||
        (signedIn() && request.resource.data.primaryUserId == request.auth.uid);
      // Clients may edit their own profile, but billing fields
      // (subscription state, Stripe ids) are set by ops or Stripe.
      allow update: if isAdmin() ||
        (ownsClientDoc(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['subscriptionStatus', 'subscriptionId', 'stripeCustomerId']));
    }

    // ---- Storage units & items ----------------------------------------
    match /storageUnits/{unitId} {
      allow read: if isAdmin() || isDriver() ||
        (isClient() && resource.data.clientId == myClientId());
      allow write: if isAdmin() || isDriver();
      // A client's delivery request moves their stored units to
      // pendingDelivery in the same batch that creates the job.
      allow update: if isClient() &&
        resource.data.clientId == myClientId() &&
        resource.data.status == 'inStorage' &&
        request.resource.data.status == 'pendingDelivery' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'jobId', 'updatedAt']);
    }
    match /items/{itemId} {
      allow read: if isAdmin() || isDriver() ||
        (isClient() && resource.data.clientId == myClientId());
      allow write: if isAdmin() || isDriver();
    }

    // ---- QR ------------------------------------------------------------
    match /qrCodes/{codeId} {
      allow read: if isAdmin() || isDriver();
      allow write: if isAdmin();
    }
    match /qrBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    // ---- Jobs ----------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        (isClient() && resource.data.clientId == myClientId());
      // Clients may create delivery requests for their own account, and the
      // pickup that an accepted quote opens. Both start unassigned and
      // scheduled; dispatch stays an admin action.
      allow create: if isAdmin() ||
        (isClient() &&
          request.resource.data.clientId == myClientId() &&
          (request.resource.data.type == 'delivery' ||
            (request.resource.data.type == 'pickup' &&
              request.resource.data.status == 'scheduled' &&
              request.resource.data.driverId == null)));
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid);
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isDriver();
      }
    }

    // ---- Quotes --------------------------------------------------------
    // The public calculator never writes here: a quote is drafted in the
    // browser and only lands once a signed-in client accepts it. Accepted
    // quotes are immutable except for the status changes ops drive.
    match /quotes/{quoteId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow create: if isAdmin() ||
        (isClient() &&
          request.resource.data.clientId == myClientId() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'accepted');
      allow update: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId() &&
          request.resource.data.status == 'cancelled');
      allow delete: if false;
    }

    // ---- Photos --------------------------------------------------------
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isDriver();
      allow update: if isAdmin();
    }

    // ---- Audit trail (append-only) ------------------------------------
    match /auditEvents/{eventId} {
      allow read: if isAdmin() || isDriver();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Notifications -------------------------------------------------
    // Every new doc is pushed (and may be emailed) by the
    // onNotificationCreated function, so only admins address people;
    // anyone signed in may raise a plain alert to the admins (userId null).
    match /notifications/{notifId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() &&
          request.resource.data.get('userId', null) == null &&
          request.resource.data.type == 'systemAlert');
      // Recipients only mark things read.
      allow update: if (isAdmin() ||
          (signedIn() && resource.data.userId == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'readAt']);
      allow delete: if false;
    }

    // ---- Driver ops ----------------------------------------------------
    match /issueReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isDriver();
      allow update: if isAdmin();
    }
    match /driverShifts/{shiftId} {
      allow read: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() &&
        request.resource.data.driverId == request.auth.uid;
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid);
    }

    // ---- Billing --------------------------------------------------------
    // Invoices are issued by the monthlyInvoices function. Admins only
    // settle an open one — paid (EFT received) or voided — never amounts.
    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow update: if isAdmin() &&
        resource.data.status == 'open' &&
        request.resource.data.status in ['paid', 'voided'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'paidAt', 'paidBy', 'paymentNote', 'voidReason',
           'updatedAt']);
      allow create, delete: if false;
    }
    match /subscriptions/{subId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow write: if false;
    }
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ---- Price list ----------------------------------------------------
    // One doc per tenant, edited in Admin → Pricing. Prices are public —
    // the website reads this doc without signing in — so reads are open;
    // only admins publish, and only a well-formed list.
    match /priceLists/{tenantId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['tenantId', 'boxes',
          'looseItemCategories', 'looseItems', 'vehicles', 'updatedAt',
          'updatedBy']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.boxes is list &&
        request.resource.data.boxes.size() <= 50 &&
        request.resource.data.looseItems is list &&
        request.resource.data.looseItems.size() <= 300 &&
        request.resource.data.vehicles is list &&
        request.resource.data.vehicles.size() <= 20 &&
        request.resource.data.looseItemCategories is list &&
        request.resource.data.looseItemCategories.size() <= 30;
      allow delete: if false;
    }

    // ---- Tenant --------------------------------------------------------
    // Business details and operations defaults (Admin → Settings). The
    // login screen shows the contact details before anyone signs in, so
    // reads are open — only public information may live on this doc, which
    // the key allow-list enforces.
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['tenantId', 'name',
          'contactPhone', 'contactEmail', 'address', 'serviceArea',
          'morning', 'afternoon', 'evening', 'paymentInstructions',
          'updatedAt', 'updatedBy']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactEmail is string &&
        request.resource.data.serviceArea is string &&
        request.resource.data.address is map &&
        request.resource.data.morning is map &&
        request.resource.data.afternoon is map &&
        request.resource.data.evening is map &&
        request.resource.data.get('paymentInstructions', '') is string &&
        request.resource.data.get('paymentInstructions', '').size() <= 500;
      allow delete: if false;
    }
  }
}
