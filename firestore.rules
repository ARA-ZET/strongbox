rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function isDriver() { return signedIn() && me().role == 'driver'; }
    // A closed account's login is deleted, but its last token works for up
    // to an hour — its archived profile reads as nobody.
    function isClient() {
      return signedIn() && me().role == 'client' &&
        me().get('isDeleted', false) != true;
    }
    function myClientId() { return me().clientId; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // A unit of the signed-in client's that is still with them, awaiting
    // pickup — the only time they add packing photos.
    function clientPackingUnit(unitId) {
      let unit = get(/databases/$(database)/documents/storageUnits/$(unitId)).data;
      return unit.clientId == myClientId() && unit.status == 'pendingPickup';
    }
    function ownsClientDoc(data) {
      return isClient() &&
        (data.primaryUserId == request.auth.uid || data.id == myClientId());
    }

    // ---- Users ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Self sign-up is always a client with no client record linked yet;
      // staff roles are granted by an admin.
      allow create: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.role == 'client' &&
          request.resource.data.get('clientId', null) == null);
      // Users edit their own profile, never their role, tenant or billing
      // state. clientId is set once, to a client record they own.
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['role', 'tenantId', 'isDeleted', 'subscriptionStatus',
             'stripeCustomerId']) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['clientId']) ||
            (resource.data.get('clientId', null) == null &&
              get(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
                .data.primaryUserId == request.auth.uid)));
    }

    // ---- Clients -------------------------------------------------------
    match /clients/{clientId} {
      allow read: if isAdmin() || ownsClientDoc(resource.data);
      allow create: if isAdmin() ||
        (isClient() && request.resource.data.primaryUserId == request.auth.uid) ||
        (signedIn() && request.resource.data.primaryUserId == request.auth.uid);
      // Clients may edit their own profile, but billing fields
      // (subscription state, Stripe ids) are set by ops or Stripe, and
      // closing an account goes through the account-closure functions.
      allow update: if isAdmin() ||
        (ownsClientDoc(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['subscriptionStatus', 'subscriptionId', 'stripeCustomerId',
             'closure', 'isDeleted', 'deletedAt', 'isActive']));
    }

    // ---- Storage units & items ----------------------------------------
    match /storageUnits/{unitId} {
      allow read: if isAdmin() || isDriver() ||
        (isClient() && resource.data.clientId == myClientId());
      // Booking (bookPickup) and delivery requests (requestDelivery) go
      // through Cloud Functions, which check ownership and status.
      allow write: if isAdmin() || isDriver();
      // While packing (unit still with them, awaiting pickup) a client may
      // add / remove their photos and note what's inside — nothing else.
      allow update: if isClient() &&
        resource.data.clientId == myClientId() &&
        resource.data.status == 'pendingPickup' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoIds', 'description', 'updatedAt']) &&
        request.resource.data.photoIds.size() <= 20 &&
        // .get: booked units have no description until the client adds one.
        (request.resource.data.get('description', null) == null ||
          (request.resource.data.description is string &&
            request.resource.data.description.size() <= 500));
    }
    match /items/{itemId} {
      allow read: if isAdmin() || isDriver() ||
        (isClient() && resource.data.clientId == myClientId());
      allow write: if isAdmin() || isDriver();
    }

    // ---- QR ------------------------------------------------------------
    match /qrCodes/{codeId} {
      allow read: if isAdmin() || isDriver();
      allow write: if isAdmin();
      // At a booked pickup the driver links a printed, unused label to an
      // item. Once linked a code never changes (rule 20).
      allow update: if isDriver() &&
        resource.data.isLinked == false &&
        request.resource.data.isLinked == true &&
        request.resource.data.storageUnitId is string &&
        request.resource.data.linkedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['storageUnitId', 'isLinked', 'linkedAt', 'linkedBy', 'tenantId']);
    }
    match /qrBatches/{batchId} {
      allow read, write: if isAdmin();
      // …and bumps its batch's linked count.
      allow update: if isDriver() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['linkedCount']);
    }

    // ---- Jobs ----------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        (isClient() && resource.data.clientId == myClientId());
      // Client bookings and delivery requests are created by the
      // bookPickup / requestDelivery functions (pendingConfirmation), never
      // from the client. Admins create ops jobs and confirm bookings.
      allow create: if isAdmin();
      // Drivers work their own dispatched jobs: check-ins, scans, photos,
      // sign-off and receiving. They can't reassign, re-price, reschedule
      // or confirm a job, or touch one ops hasn't confirmed.
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid &&
          resource.data.status != 'pendingConfirmation' &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'departedAt', 'arrivedAt', 'collectedAt', 'completedAt',
            'scannedUnitIds', 'receivedUnitIds', 'handedOverUnitIds',
            'photoIds', 'clientSignatureUrl', 'clientConfirmMethod',
            'recipientName', 'driverNotes', 'updatedAt']) &&
          request.resource.data.status in
            ['inProgress', 'collected', 'completed']);
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isDriver();
      }
    }

    // ---- Quotes --------------------------------------------------------
    // The public calculator never writes here: a quote is drafted in the
    // browser and only lands once a signed-in client accepts it. Accepted
    // quotes are immutable except for the status changes ops drive.
    match /quotes/{quoteId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow create: if isAdmin() ||
        (isClient() &&
          request.resource.data.clientId == myClientId() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'accepted');
      allow update: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId() &&
          request.resource.data.status == 'cancelled');
      allow delete: if false;
    }

    // ---- Photos --------------------------------------------------------
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isDriver() ||
        // A client's packing photo of their own box awaiting pickup.
        (isClient() &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.entityType == 'storageUnit' &&
          request.resource.data.type in ['interior', 'exterior'] &&
          request.resource.data.isDeleted == false &&
          clientPackingUnit(request.resource.data.entityId));
      allow update: if isAdmin() ||
        // …which they may remove (soft delete) while still packing.
        (isClient() &&
          resource.data.uploadedBy == request.auth.uid &&
          clientPackingUnit(resource.data.entityId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isDeleted', 'deletedAt']) &&
          request.resource.data.isDeleted == true);
    }

    // ---- Audit trail (append-only) ------------------------------------
    match /auditEvents/{eventId} {
      allow read: if isAdmin() || isDriver();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Notifications -------------------------------------------------
    // Every new doc is pushed (and may be emailed) by the
    // onNotificationCreated function, so only admins address people;
    // anyone signed in may raise a plain alert to the admins (userId null).
    match /notifications/{notifId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() &&
          request.resource.data.get('userId', null) == null &&
          request.resource.data.type == 'systemAlert');
      // Recipients only mark things read.
      allow update: if (isAdmin() ||
          (signedIn() && resource.data.userId == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'readAt']);
      allow delete: if false;
    }

    // ---- Driver ops ----------------------------------------------------
    match /issueReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isDriver();
      allow update: if isAdmin();
    }
    // Fleet vehicles and trailers — admins manage them; drivers can see
    // them (e.g. to pick one for a shift). Retire = soft delete.
    match /vehicles/{vehicleId} {
      allow read: if isAdmin() || isDriver();
      allow create, update: if isAdmin() &&
        request.resource.data.tenantId is string &&
        request.resource.data.registration is string &&
        request.resource.data.registration.size() > 0 &&
        request.resource.data.registration.size() <= 20 &&
        request.resource.data.type in
          ['car', 'bakkie', 'van', 'truck', 'trailer'] &&
        request.resource.data.status in
          ['available', 'maintenance', 'outOfService'];
      allow delete: if false;
    }
    match /driverShifts/{shiftId} {
      allow read: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() &&
        request.resource.data.driverId == request.auth.uid;
      allow update: if isAdmin() ||
        (isDriver() && resource.data.driverId == request.auth.uid);
    }

    // ---- Outbound email -------------------------------------------------
    // Written by Cloud Functions only; onMailCreated sends each doc and
    // records `delivery`. Admins read it to see whether an invite went out.
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Billing --------------------------------------------------------
    // Invoices are issued by the monthlyInvoices function. Admins only
    // settle an open one — paid (EFT received) or voided — never amounts.
    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow update: if isAdmin() &&
        resource.data.status == 'open' &&
        request.resource.data.status in ['paid', 'voided'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'paidAt', 'paidBy', 'paymentNote', 'voidReason',
           'updatedAt']);
      allow create, delete: if false;
    }
    match /subscriptions/{subId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == myClientId());
      allow write: if false;
    }
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ---- Price list ----------------------------------------------------
    // One doc per tenant, edited in Admin → Pricing. Prices are public —
    // the website reads this doc without signing in — so reads are open;
    // only admins publish, and only a well-formed list.
    match /priceLists/{tenantId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['tenantId', 'boxes',
          'looseItemCategories', 'looseItems', 'vehicles', 'supplies',
          'packingHelper', 'updatedAt', 'updatedBy']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.boxes is list &&
        request.resource.data.boxes.size() <= 50 &&
        request.resource.data.looseItems is list &&
        request.resource.data.looseItems.size() <= 300 &&
        request.resource.data.vehicles is list &&
        request.resource.data.vehicles.size() <= 20 &&
        request.resource.data.looseItemCategories is list &&
        request.resource.data.looseItemCategories.size() <= 30 &&
        (!('supplies' in request.resource.data) ||
          (request.resource.data.supplies is list &&
            request.resource.data.supplies.size() <= 30)) &&
        (!('packingHelper' in request.resource.data) ||
          request.resource.data.packingHelper is map);
      allow delete: if false;
    }

    // ---- Tenant --------------------------------------------------------
    // Business details and operations defaults (Admin → Settings). The
    // login screen shows the contact details before anyone signs in, so
    // reads are open — only public information may live on this doc, which
    // the key allow-list enforces.
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['tenantId', 'name',
          'contactPhone', 'contactEmail', 'address', 'serviceArea',
          'morning', 'afternoon', 'evening', 'paymentInstructions',
          'updatedAt', 'updatedBy']) &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactEmail is string &&
        request.resource.data.serviceArea is string &&
        request.resource.data.address is map &&
        request.resource.data.morning is map &&
        request.resource.data.afternoon is map &&
        request.resource.data.evening is map &&
        request.resource.data.get('paymentInstructions', '') is string &&
        request.resource.data.get('paymentInstructions', '').size() <= 500;
      allow delete: if false;
    }
  }
}
